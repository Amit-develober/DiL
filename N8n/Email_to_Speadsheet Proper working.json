    {
      "parameters": {
        "jsCode": "// Get email content\nlet emailText = $json.text || $json.html || \"\";\n\n// Clean HTML + normalize text\nemailText = emailText\n  .replace(/<[^>]*>/g, \"\")     // remove HTML\n  .replace(/\\r\\n/g, \"\\n\")      // normalize line breaks\n  .replace(/\\n+/g, \"\\n\")       // remove extra lines\n  .trim();\n\n// Split into lines\nconst lines = emailText.split(\"\\n\");\n\n// Initialize fields\nlet name = \"\";\nlet email = \"\";\nlet message = \"\";\n\n// Extract data line-by-line (STRICT matching)\nfor (let line of lines) {\n  line = line.trim();\n\n  if (/^name\\s*:/i.test(line)) {\n    name = line.split(\":\")[1]?.trim();\n  }\n\n  if (/^email\\s*:/i.test(line)) {\n    email = line.split(\":\")[1]?.trim();\n  }\n\n  if (/^message\\s*:/i.test(line)) {\n    message = line.split(\":\")[1]?.trim();\n  }\n}\n\n// Convert DateTime to IST (India)\nconst rawDate = $json.date || $json.internalDate || new Date();\n\nconst d = new Date(rawDate);\n\nconst formattedDate =\n  d.toLocaleDateString(\"en-IN\", { timeZone: \"Asia/Kolkata\" }) +\n  \" \" +\n  d.toLocaleTimeString(\"en-IN\", { timeZone: \"Asia/Kolkata\" });\n\n// Return final clean data\nreturn [\n  {\n    json: {\n      name: name || \"Not Found\",\n      email: email || \"Not Found\",\n      datetime: formattedDate,\n      message: message || \"Not Found\"\n    }\n  }\n];"
      },
